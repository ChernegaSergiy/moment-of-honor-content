{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://moment-of-honor.dev/schema/feed.schema.json",
  "title": "Feed",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedAt", "posts", "stories"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "posts": {
      "type": "array",
      "items": { "$ref": "post.schema.json" }
    },
    "stories": {
      "type": "array",
      "items": { "$ref": "story.schema.json" }
    }
  }
}
