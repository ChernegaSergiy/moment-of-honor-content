{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://moment-of-honor.dev/schema/post.schema.json",
  "title": "Post",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "title", "content", "author", "publishedAt"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$",
      "description": "Unique identifier, must match the filename without extension"
    },
    "type": {
      "const": "post"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "media": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^media/posts/.+$"
      },
      "default": []
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
