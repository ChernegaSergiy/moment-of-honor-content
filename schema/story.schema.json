{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://moment-of-honor.dev/schema/story.schema.json",
  "title": "Story",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "media", "publishedAt", "expiresAt"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-\\d{2}$",
      "description": "Unique identifier, must match the filename without extension"
    },
    "type": {
      "const": "story"
    },
    "media": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^media/stories/.+$"
      }
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
